#!/bin/sh
# Local mirror of .github/workflows/mutation.yml's pull-request mode, scoped to
# the diff against origin/main. CI retains a full-tree gate for code pushes to
# main. Hard-fails on escaped mutants, on a gate miss, and on any missing tool -
# no silent skips.
#
# Not opt-out by default. To enable this hook, run once:
#   git config core.hooksPath githooks
set -eu

ROOT_DIR=$(git rev-parse --show-toplevel)
cd "$ROOT_DIR"
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_QUARANTINE_PATH

require_tool() {
	tool="$1"
	hint="$2"
	if ! command -v "$tool" >/dev/null 2>&1; then
		printf 'FAIL: required tool "%s" not found on PATH.\n  install with: %s\n' "$tool" "$hint" >&2
		exit 1
	fi
}

require_tool go "https://go.dev/doc/install"

# Skip only when every pushed ref is a delete (no new commits to analyze).
# This is the one legitimate no-op case for a pre-push hook, not a silent
# skip of a check: a deleted ref has no diff to mutate.
ANY_UPDATE=0
while read -r local_ref local_sha remote_ref remote_sha; do
	if [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
		ANY_UPDATE=1
	fi
done
if [ "$ANY_UPDATE" -eq 0 ]; then
	echo "pre-push: only ref deletions pushed, nothing to mutate."
	exit 0
fi

if ! git rev-parse --verify origin/main >/dev/null 2>&1; then
	printf 'FAIL: origin/main not found locally. Run: git fetch origin main\n' >&2
	exit 1
fi

echo "pre-push: running mutation testing scoped to the diff against origin/main..."
STATUS=0
GOMAXPROCS=1 MUTAGO_WORKERS=1 ./scripts/check-change.sh || STATUS=$?

if [ "$STATUS" -eq 4 ]; then
	printf '\nFAIL: mutation quality gate not met (escaped mutants in the diff against origin/main).\n' >&2
	exit 1
elif [ "$STATUS" -ne 0 ]; then
	printf '\nFAIL: mutago exited with status %s (tool error).\n' "$STATUS" >&2
	exit 1
fi

printf '\nmutation quality gate passed.\n'
